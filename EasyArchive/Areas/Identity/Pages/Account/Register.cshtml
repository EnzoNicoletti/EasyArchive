@page
@model RegisterModel

@{
    ViewData["Title"] = "Conectar-se";
}

<div class="container d-flex justify-content-center align-items-lg-center vh-75"
     style="background-color: #FEF3E2;">

    <div class="row w-100 justify-content-center">
        <div class="col-11 col-sm-8 col-md-6 col-lg-4">

            <div class="card shadow-sm rounded-4"
                 style="background-color: #FFE8C4;">

                <div class="card-body p-4">

                    <h1 class="text-center fw-bold mb-2">
                        @ViewData["Title"]
                    </h1>

                    <p class="text-center text-muted mb-4">
                        Conecte-se à sua conta
                    </p>

                    <form id="registerForm"
                          asp-route-returnUrl="@Model.ReturnUrl"
                          method="post">

                        <div asp-validation-summary="ModelOnly"
                             class="text-danger text-center mb-3"
                             role="alert"></div>

                        <div class="form-floating mb-3">
                            <input asp-for="Input.Email"
                                   class="form-control rounded-3"
                                   autocomplete="username"
                                   placeholder="name@example.com" />
                            <label asp-for="Input.Email">Email</label>
                            <span asp-validation-for="Input.Email"
                                  class="text-danger small"></span>
                        </div>

                        <div class="form-floating mb-3">
                            <input asp-for="Input.Password"
                                   class="form-control rounded-3"
                                   autocomplete="current-password"
                                   placeholder="password" />
                            <label asp-for="Input.Password">Senha</label>
                            <span asp-validation-for="Input.Password"
                                  class="text-danger small"></span>
                        </div>

                        <button type="submit"
                                class="btn btn-primary btn-lg w-100 rounded-3" style="background-color: #FAB12F">
                            Conectar
                        </button>

                    </form>

                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
