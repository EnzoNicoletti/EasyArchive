@model EasyArchive.Models.Emprestimo

@{
    ViewData["Title"] = "Cadastrar Empréstimo";
}

<div class="container-fluid min-vh-100 d-flex justify-content-center align-items-center"
     style="background-color: #FEF3E2;">

    <div class="col-md-6 col-lg-5 col-xl-4">
        <div class="card shadow-sm rounded-4"
             style="background-color: #FFE8C4;">

            <div class="card-body p-4">

                <h3 class="text-center mb-1">Cadastrar Empréstimo</h3>
                <p class="text-center text-muted mb-4">
                    Selecione o aluno, o livro, e as datas
                </p>

                <form asp-action="Create">
                    <div asp-validation-summary="ModelOnly"
                         class="text-danger mb-3"></div>

                    <div class="form-group mb-3">
                        <label asp-for="AlunoId" class="form-label"></label>
                        <select asp-for="AlunoId"
                                class="form-control"
                                asp-items="ViewBag.AlunoId">
                            <option value="">Selecione um aluno</option>
                        </select>
                        <span asp-validation-for="AlunoId"
                              class="text-danger"></span>
                    </div>

                    <div class="form-group mb-3">
                        <label asp-for="LivroId" class="form-label"></label>
                        <select asp-for="LivroId"
                                class="form-control"
                                asp-items="ViewBag.LivroId">
                            <option value="">Selecione um livro</option>
                        </select>
                        <span asp-validation-for="LivroId"
                              class="text-danger"></span>
                    </div>

                    <div class="form-group mb-4">
                        <label asp-for="DataDevolucao" class="form-label"></label>
                        <input asp-for="DataDevolucao"
                               type="date"
                               class="form-control" />
                        <span asp-validation-for="DataDevolucao"
                              class="text-danger"></span>
                    </div>

                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-primary" style="background-color: #FAB12F">
                            Realizar Empréstimo
                        </button>
                        <a asp-action="Index"
                           class="btn btn-secondary">
                            Voltar à lista
                        </a>
                    </div>
                </form>

            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
