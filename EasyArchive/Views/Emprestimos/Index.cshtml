@model IEnumerable<EasyArchive.Models.Emprestimo>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>

<form asp-action="Filtro" method="get">
    <select name="AlunoId" class="form-select">
        <option value="">Todas as contas financeiras</option>
        @foreach (var Aluno in ViewBag.Alunos)
        {
            <option value="@Aluno.AlunoId">@Aluno.Nome</option>
        }
    </select>
    <button type="submit" class="btn btn-primary mt-2">Filtrar</button>
</form>

<table class="table text-center">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Aluno)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Livro)
            </th>
            <th>
                Data do Empréstimo
            </th>
            <th>
                Data de Devolução
            </th>
            <th>
                Emprestado?
            </th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.Aluno.Nome)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Livro.Titulo)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.DataEmprestimo)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.DataDevolucao)
                </td>
                <td class="text-cen">
                    @Html.DisplayFor(modelItem => item.Livro.Emprestado)
                </td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.EmprestimoId">Edit</a> |
                    <a asp-action="Details" asp-route-id="@item.EmprestimoId">Details</a> |
                    <a asp-action="Delete" asp-route-id="@item.EmprestimoId">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
