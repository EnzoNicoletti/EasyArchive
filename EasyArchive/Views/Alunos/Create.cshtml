@model EasyArchive.Models.Aluno

@{
    ViewData["Title"] = "Cadastrar Aluno";
}

<div class="container-fluid min-vh-100 d-flex justify-content-center align-items-center"
     style="background-color: #FEF3E2;">

    <div class="col-md-6 col-lg-5 col-xl-4">
        <div class="card shadow-sm rounded-4"
             style="background-color: #FFE8C4;">

            <div class="card-body p-4">

                <h3 class="text-center mb-1">Cadastre Um Aluno</h3>
                <p class="text-center text-muted mb-4">
                    Informe os dados do aluno
                </p>

                <form asp-action="Create">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="form-group mb-3">
                        <label asp-for="Nome" class="form-label"></label>
                        <input asp-for="Nome" class="form-control"
                               placeholder="Ex: João da Silva" />
                        <span asp-validation-for="Nome" class="text-danger"></span>
                    </div>

                    <div class="form-group mb-3">
                        <label asp-for="Curso" class="form-label"></label>
                        <input asp-for="Curso" class="form-control"
                               placeholder="Ex: Informática" />
                        <span asp-validation-for="Curso" class="text-danger"></span>
                    </div>

                    <div class="form-group mb-4">
                        <label asp-for="RM" class="form-label"></label>
                        <input asp-for="RM" class="form-control"
                               placeholder="Ex: 12345" />
                        <span asp-validation-for="RM" class="text-danger"></span>
                    </div>

                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-primary" style="background-color: #FAB12F">
                            Cadastrar
                        </button>
                        <a asp-action="Index"
                           class="btn btn-secondary">
                            Voltar à lista
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
