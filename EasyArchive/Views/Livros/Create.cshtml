@model EasyArchive.Models.Livro

@{
    ViewData["Title"] = "Criar Livro";
}

<div class="container-fluid min-vh-100 d-flex justify-content-center align-items-center"
     style="background-color: #FEF3E2;">

    <div class="col-md-6 col-lg-5 col-xl-4">
        <div class="card shadow-sm rounded-4" style="background-color: #FFE8C4">
            <div class="card-body p-4">

                <h3 class="text-center mb-1">Registre Seu Livro</h3>
                <p class="text-center text-muted mb-4">
                    Informe os dados do Livro
                </p>

                <form asp-action="Create">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="form-group mb-3">
                        <label asp-for="Titulo" class="form-label"></label>
                        <input asp-for="Titulo" class="form-control"
                               placeholder="Ex: Dom Casmurro" />
                        <span asp-validation-for="Titulo" class="text-danger"></span>
                    </div>

                    <div class="form-group mb-3">
                        <label asp-for="Autor" class="form-label"></label>
                        <input asp-for="Autor" class="form-control"
                               placeholder="Ex: Machado de Assis" />
                        <span asp-validation-for="Autor" class="text-danger"></span>
                    </div>

                    <div class="form-group mb-3">
                        <label asp-for="Editora" class="form-label"></label>
                        <input asp-for="Editora" class="form-control"
                               placeholder="Ex: Companhia das Letras" />
                        <span asp-validation-for="Editora" class="text-danger"></span>
                    </div>

                    <div class="form-group mb-4">
                        <label asp-for="AnoPublicacao" class="form-label"></label>
                        <input asp-for="AnoPublicacao" type="number"
                               class="form-control" placeholder="Ex: 1899" />
                        <span asp-validation-for="AnoPublicacao" class="text-danger"></span>
                    </div>

                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-primary" style="background-color: #FAB12F">
                            Registrar
                        </button>
                        <a asp-action="Index" class="btn btn-secondary">
                            Voltar à lista
                        </a>
                    </div>
                </form>

            </div>
        </div>
    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}

